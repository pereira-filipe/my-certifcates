# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Full list and meaning: specs/BACKEND.md §7.

# PostgreSQL (docker-compose.yml, dev only)
POSTGRES_DB=mycertificates
POSTGRES_USER=mycertificates
POSTGRES_PASSWORD=change-me

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mycertificates
SPRING_DATASOURCE_USERNAME=mycertificates
SPRING_DATASOURCE_PASSWORD=change-me
# Owner account: only used on first startup, when the database has no user yet.
APP_OWNER_EMAIL=you@example.com
APP_OWNER_PASSWORD=change-me-at-least-12-chars
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_DIR=./uploads
APP_BASE_URL=http://localhost:5173
