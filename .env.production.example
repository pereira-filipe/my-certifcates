# Production secrets for Fly.io. Copy to .env.production (git-ignored), fill in, then:
#   fly secrets import < .env.production
# Neon: Dashboard → your project → Connect → choose "Java"/JDBC, *without* the pooler (no "-pooler" in the host).
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=
# Your login on the live site (created on the first start; at least 12 characters).
APP_OWNER_EMAIL=
APP_OWNER_PASSWORD=
